generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model club {
  id         Int    @id @default(autoincrement())
  league_key String @default("global")
  nombre     String
  crest_url  String

  players player_table[]
  users   user_table[]

  home_matches match_row[] @relation("HomeClub")
  away_matches match_row[] @relation("AwayClub")

  @@unique([league_key, nombre])
  @@index([league_key])
}

model league_table_row {
  id            BigInt   @id @default(autoincrement())
  league_preset String
  table_index   Int      @default(1)
  table_title   String?
  team          String
  pts           Int?
  played        Int?
  wins          Int?
  draws         Int?
  losses        Int?
  gf            Int      @default(0)
  ga            Int      @default(0)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([league_preset, table_index, team])
}

model match_row {
  id         Int       @id @default(autoincrement())
  league     String
  match_date DateTime? @default(now()) @db.Timestamptz(6)
  minute     Int?
  score_home Int?
  score_away Int?
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  // Campos viejos (necesarios para el backfill)
  home_team String
  away_team String

  // Nuevas FKs OPCIONALES
  home_club_id Int?
  away_club_id Int?
  home_club    club? @relation("HomeClub", fields: [home_club_id], references: [id])
  away_club    club? @relation("AwayClub", fields: [away_club_id], references: [id])

  @@index([home_club_id])
  @@index([away_club_id])
}

model user_table {
  id         Int    @id @default(autoincrement())
  usuario    String @unique
  mail       String @unique
  club_id    Int
  contrasena String

  // Relación con el club
  club club @relation(fields: [club_id], references: [id])
}

model player_table {
  id        Int    @id @default(autoincrement())
  full_name String
  team_id   Int
  team      club   @relation(fields: [team_id], references: [id]) // ← apunta a `club`

  @@index([team_id])
}
