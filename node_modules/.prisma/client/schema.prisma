generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model club_logo {
  league_key String  @default("global")
  name       String  @db.Citext
  name_norm  String
  crest_url  String
  pais       String?
  pais_key   String?

  @@id([league_key, name_norm])
  @@index([pais_key, name_norm], map: "club_logo_pais_idx")
}

model league_table_row {
  id            BigInt   @id @default(autoincrement())
  league_preset String
  table_index   Int      @default(1)
  table_title   String?
  pos           Int?
  team          String
  crest         String?
  pts           Int?
  played        Int?
  wins          Int?
  draws         Int?
  losses        Int?
  gf            Int?
  ga            Int?
  diff          Int?
  source_url    String?
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([league_preset, table_index, team])
  @@index([league_preset, table_index, pos], map: "idx_league_order")
}

model match_row {
  id         String    @id
  match_date String
  league     String?
  home_team  String?
  away_team  String?
  score_home Int?
  score_away Int?
  status     String?
  minute     Int?
  source_url String?
  last_hash  String?
  first_seen DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}
