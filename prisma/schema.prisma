generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model club {
  id          Int             @id @default(autoincrement())
  league_key  String          @default("global")
  nombre      String          
  crest_url   String

  players     player_table[]  // ← relacion con jugadores
  users       user_table[]   // ← relacion con usuarios

  @@index([league_key])
  @@unique([league_key, nombre])
}


model league_table_row {
  id            BigInt   @id @default(autoincrement())
  league_preset String
  table_index   Int      @default(1)
  table_title   String?
  team          String
  pts           Int?
  played        Int?
  wins          Int?
  draws         Int?
  losses        Int?
  gf            Int  @default(0)
  ga            Int  @default(0)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([league_preset, table_index, team])
}

model match_row {
  id         String    @id
  league     String
  home_team  String
  away_team  String
  score_home Int?
  score_away Int?
  minute     Int?
  source_url String?
  last_hash  String?
  match_date DateTime? @default(now()) @db.Timestamptz(6)
  first_seen DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

model user_table {
  id          Int      @id @default(autoincrement())
  usuario     String   @unique
  mail        String   @unique
  club_id     Int
  contrasena  String

  // Relación con el club
  club        club     @relation(fields: [club_id], references: [id])
}

model player_table {
  id         Int     @id @default(autoincrement())
  full_name  String
  team_id    Int
  team       club    @relation(fields: [team_id], references: [id]) // ← apunta a `club`

  @@index([team_id])
}



