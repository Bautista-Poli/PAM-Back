generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model club {
  id           Int            @id @default(autoincrement())
  league_key   String         @default("global")
  nombre       String
  crest_url    String
  clubInfo     Club_Info?
  away_matches match_row[]    @relation("AwayClub")
  home_matches match_row[]    @relation("HomeClub")
  players      player_table[]
  users        user_table[]

  @@unique([league_key, nombre])
  @@index([league_key])
}

model Club_Info {
  id                Int    @id @default(autoincrement())
  clubId            Int    @unique
  titulosNacionales Int    @default(0)
  titulosInternac   Int    @default(0)
  añoFundacion     Int
  nombreEstadio     String @db.VarChar(100)
  capacidadEstadio  Int
  ciudad            String @db.VarChar(50)
  colores           String @db.VarChar(100)
  entrenador        String @db.VarChar(100)
  club              club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
}

model league_table_row {
  id            BigInt      @id @default(autoincrement())
  league_preset String
  table_index   Int      @default(1)
  table_title   String?
  team          String
  pts           Int?
  played        Int?
  wins          Int?
  draws         Int?
  losses        Int?
  gf            Int      @default(0)
  ga            Int      @default(0)
  updated_at    DateTime @default(now()) @db.Timestamptz(6)


  @@unique([league_preset, table_index, team])
}
enum match_event_type {
  YELLOW_CARD
  RED_CARD
  GOAL
  SUBSTITUTION
}

model match_row {
  league       String
  home_team    String
  away_team    String
  score_home   Int?
  score_away   Int?
  minute       Int?
  updated_at   DateTime?       @default(now()) @db.Timestamptz(6)
  match_date   DateTime?       @default(now()) @db.Timestamptz(6)
  away_club_id Int?
  home_club_id Int?
  id           Int             @id @default(autoincrement())
  away_club    club?           @relation("AwayClub", fields: [away_club_id], references: [id])
  home_club    club?           @relation("HomeClub", fields: [home_club_id], references: [id])
  ratings      player_rating[]
  espn_id       String?         @unique

  @@index([home_club_id])
  @@index([away_club_id])
  @@unique([home_team, away_team, match_date])
}


model match_event {
  id              Int      @id @default(autoincrement())
  match_id        Int
  espn_id         String?
  
  type            String   // "yellow-card", "red-card", etc.
  minute          Int?
  clock_display   String?
  description     String?
  
  team_name       String?
  player_name     String?

  @@index([match_id])
  @@index([espn_id])
  @@unique([match_id, type, minute,player_name]) 
}

model user_table {
  id         Int             @id @default(autoincrement())
  usuario    String          @unique
  mail       String          @unique
  club_id    Int
  contrasena String
  ratings    player_rating[]
  club       club            @relation(fields: [club_id], references: [id])
}

model player_table {
  id        Int             @id @default(autoincrement())
  full_name String
  team_id   Int
  ratings   player_rating[]
  team      club            @relation(fields: [team_id], references: [id])

  @@index([team_id])
}

model player_rating {
  id         Int          @id @default(autoincrement())
  user_id    Int
  match_id   Int?
  player_id  Int
  rating     Int
  created_at DateTime     @default(now()) @db.Timestamptz(6)
  match     match_row? @relation(fields: [match_id], references: [id], onDelete: SetNull)
  player     player_table @relation(fields: [player_id], references: [id])
  user       user_table   @relation(fields: [user_id], references: [id])

  @@unique([user_id, match_id, player_id])
  @@index([player_id])
  @@index([match_id])
}
